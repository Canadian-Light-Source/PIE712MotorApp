# VERY Important for XPS controller, set VBAS to 0.0, set ACCL to (max velo stated in XPS stages.ini) / (max accel stated in XPS stages.ini)
file "$(MOTOR)/db/basic_asyn_motor.db"
{
	pattern
	{P,    N, 	M,       DTYP,   		PORT, 	ADDR, DESC,   				EGU,	DIR,   VELO,  	VBAS, 	ACCL, 	BDST, BVEL, BACC, 	MRES, PREC,  	DLLM, 	DHLM, 	RTRY	INIT}
	{SIM_IOC:, 700, "m$(N)", "asynMotor",	"E712", 	0, 		"SampleFineX",	um,  	Pos,    1000.0, 0.00,  	1.0,    0,  	.2,   .2,    	0.001,  5,   		-100,		100,  0,			""}
 	{SIM_IOC:, 701, "m$(N)", "asynMotor",	"E712", 	1, 		"SampleFineY",	um,  	Pos,    1000.0, 0.00,  	1.0,    0,  	.2,   .2,    	0.001,  5,   		-100,		100,  0,			""}
}

file "$(TOP)/db/motorCal.db"
{
	pattern
	{clsdev,  motor, 	unit,   calibPosn,   	move1, 	move2, calibLimit,  finalPosn,	offset}
	{SIM_IOC:, 		m700, 		um,				0.0					0,			0,			HLS, 				0,			0		}      # SampleFineX  
	{SIM_IOC:, 		m701, 		um,				0.0					0,			0,			HLS, 				0,			0		}      # SampleFineY  
	
}



