XPSCreateController("XPS2", "192.168.168.100", 5001, 5, 2, 10, 1, 500)

#asynSetTraceIOMask("XPS2", 0, 255)
#asynSetTraceMask("XPS2", 0, 255)

# stepSize = 1 / stages.ini[DisplacementPerFullStep]
# XPS asyn port,  axis, groupName.positionerName, stepSize

XPSCreateAxis("XPS2",0,  "CoarseX.X",  	"1000")
XPSCreateAxis("XPS2",1,  "CoarseY.Y",  	"1000")	
XPSCreateAxis("XPS2",2,  "DetectorX.X", "1000")
XPSCreateAxis("XPS2",3,  "DetectorY.Y", "1000")
XPSCreateAxis("XPS2",4,  "DetectorZ.Z", "1000")

#prevent the controller from reporting a "controller error" id the axis is disabled
XPSNoDisableError("XPS2")
XPSEnableMovingMode("XPS2")
dbLoadRecords("$(ASYN)/db/asynRecord.db", "P=IOC:, R=XPS2, PORT=XPS2, ADDR=0, OMAX=256, IMAX=256")   

