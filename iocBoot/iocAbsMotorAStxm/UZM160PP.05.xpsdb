;--- unit =millimeter
;--- COARSE Y

;--- Stage
SmartStageName=

;--- Driver
DriverName=XPS-DRV01
DriverPWMFrequency=50; kHz
DriverStepperWinding=Full; Full or Half

;--- Motor driver interface
MotorDriverInterface=AnalogStepperPosition
DisplacementPerFullStep=0.0005; units
ScalingCurrent=3; amps for 10 V
PeakCurrentPerPhase=0.86; amps
StandbyPeakCurrentPerPhase=0.1; amps
BaseVelocity=0; units / sec

;--- Encoder
EncoderType=AquadB
EncoderResolution=0.0001; unit
LinearEncoderCorrection=0; ppm

;----Gathering
CurrentVelocityCutOffFrequency=10
CurrentAccelerationCutOffFrequency=100

;--- Backlash
Backlash=0; unit

;--- Positioner mapping
PositionerMappingFileName=

;--- Travels
MinimumTargetPosition=0.00; unit
HomePreset=0; unit
MaximumTargetPosition=8.75; unit

;--- Home
HomeSearchSequenceType=MinusEndOfRunHomeSearch
;HomeSearchSequenceType =MechanicalZeroAndIndexHomeSearch
;HomeSearchSequenceType =CurrentPositionAsHome
HomeSearchMaximumVelocity=0.4; unit / second
HomeSearchMaximumAcceleration=2; unit / second
HomeSearchTimeOut=100; second

;--- Profiler
MaximumVelocity=1; unit / second
MaximumAcceleration=4; unit / second2
EmergencyDecelerationMultiplier=1
MinimumJerkTime=0.005; second
MaximumJerkTime=0.05; second
TrackingCutOffFrequency=25; Hz

;--- Motion done
MotionDoneMode=Theoretical

;--- Corrector
CorrectorType=PIPosition

KP=0
KI=10
KS=0.8
IntegrationTime=1000000
ClosedLoopStatus=Closed; Opened or Closed
FatalFollowingError=0.1
DeadBandThreshold=0; units


;--- Notch Filter
NotchFrequency1=0; Hertz
NotchBandwidth1=0; Hertz
NotchGain1=1
NotchFrequency2=0; Hertz
NotchBandwidth2=0; Hertz
NotchGain2=1

;--- Servitude
ServitudesType=StandardEORDriverPlug
