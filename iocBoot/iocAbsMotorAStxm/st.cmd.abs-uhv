# The is the ASYN example for communication to 4 simulated motors
# "#!" marks lines that can be uncommented.
#THE following file must be at the top before any other calls
< C:/controls/epics/R3.14.12.4/local/src/blApiApp/UHV_STXM_CONFIG
epicsEnvSet(TOP,"C:/controls/epics/R3.14.12.4/modules/support/motor-6-8")

< $(IOCDIR)/envPaths

# load the specified mode driven startup file for the Abstract motor app
< $(TOP)/iocBoot/iocAbsMotorUHV/$(ABSTRACT_MTR_MODE_ST_FILE)



