# The is the ASYN example for communication to 4 simulated motors
# "#!" marks lines that can be uncommented.

< envPaths

dbLoadDatabase("$(TOP)/dbd/AgilentMotor.dbd")
AgilentMotor_registerRecordDeviceDriver(pdbbase)

# AgilentMotorCreateController{	"Port name","Number of axes", "Moving poll rate (ms)", "Idle poll rate (ms)")

AgilentMotorCreateController("agilentCtrl", 2, 10, 100)


dbLoadTemplate("motor.substitutions.agilent")
dbLoadRecords(("db/agilentStatus.db", "P=IOC:,M=m1:,PORT=agilentCtrl,ADDR=0,TIMEOUT=1")
dbLoadRecords(("db/agilentStatus.db", "P=IOC:,M=m2:,PORT=agilentCtrl,ADDR=1,TIMEOUT=1")

dbLoadRecords(("db/Agilent.db", "P=IOC:,M=m1:,PORT=agilentCtrl,ADDR=0,TIMEOUT=1")
dbLoadRecords(("db/Agilent.db", "P=IOC:,M=m2:,PORT=agilentCtrl,ADDR=1,TIMEOUT=1")



### Scan-support software
# crate-resident scan.  This executes 1D, 2D, 3D, and 4D scans, and caches
# 1D data, but it doesn't store anything to disk.  (You need the data catcher
# or the equivalent for that.)  This database is configured to use the
# "alldone" database (above) to figure out when motors have stopped moving
# and it's time to trigger detectors.
dbLoadRecords("$(SSCAN)/db/scan.db", "P=scanTest:,MAXPTS1=2000,MAXPTS2=200,MAXPTS3=20,MAXPTS4=10,MAXPTSH=10")
dbLoadRecords("$(SSCAN)/db/standardScans.db", "P=scanTest:,MAXPTS1=2000,MAXPTS2=200,MAXPTS3=20,MAXPTS4=10,MAXPTSH=10")
dbLoadRecords("$(SSCAN)/db/scanProgress.db", "P=scanTest:,MAXPTS1=2000,MAXPTS2=200,MAXPTS3=20,MAXPTS4=10,MAXPTSH=10")
dbLoadRecords("$(SSCAN)/db/scanParms.db", "P=scanTest:,SCANREC=scanTest:scan1,Q=twoD")




#asynSetTraceIOMask("agilentCtrl", 0, 4)
#asynSetTraceMask("agilentCtrl", 0, 255)

# AgilentMotorConfigAxis(port, axis, axisName, lowLimit, highLimit, home, start)
AgilentMotorConfigAxis("agilentCtrl", 0, "pmcX", 20000, -20000,  500, 0)
AgilentMotorConfigAxis("agilentCtrl", 1, "pmcY", 20000, -20000,  500, 0)
iocInit

#settings for beam line
dbpf("IOC:m1.PCOF", 	"0.5") 		# dCoEffProp: 0.5
dbpf("IOC:m1.ICOF", 	"0.001") 	# dCoEffInt: 0.001
dbpf("IOC:m1.DCOF", 	"1.0") 		# dCoEffDiff: 1.0
dbpf("IOC:m1.RTRY", 	"1") 			# max retries
dbpf("IOC:m1.ACCL", 	"0.01") 			# 10 ms to reach peak velo
dbpf("IOC:m1.VBAS", 	"0.001") 			# 10 ms to reach peak velo

dbpf("IOC:m2.PCOF", 	"0.2") 		# dCoEffProp: 0.2
dbpf("IOC:m2.ICOF", 	"0.001") 	# dCoEffInt: 0.001
dbpf("IOC:m2.DCOF", 	"1.0") 		# dCoEffDiff: 1.0
dbpf("IOC:m2.RTRY", 	"1") 			# max retries
dbpf("IOC:m2.ACCL", 	"0.01") 			# 10 ms to reach peak velo
dbpf("IOC:m2.VBAS", 	"0.001") 			# 10 ms to reach peak velo