# The is the ASYN example for communication to 4 simulated motors
# "#!" marks lines that can be uncommented.

< $(IOCDIR)/envPaths

#epicsEnvSet(MAX_FINEX_SCAN_RANGE, 80)
#epicsEnvSet(MAX_FINEY_SCAN_RANGE, 20)

epicsEnvSet(MAX_FINEX_SCAN_RANGE, 98)
epicsEnvSet(MAX_FINEY_SCAN_RANGE, 98)

dbLoadDatabase("$(TOP)/dbd/uhvAbsMotor.dbd")
uhvAbsMotor_registerRecordDeviceDriver(pdbbase)


dbLoadRecords("$(HEARTBEAT_APP_DIR)/db/app_hrtbt.db","app=UHVMTRS")

#########################################################
# PI E-712 Controller
dbLoadTemplate "$(TOP)/iocBoot/iocPIE712WithAsyn/motor.substitutions.pi_e712"
drvAsynIPPortConfigure("L100", "192.168.168.10:50000",0,0,0)
# now one for the data recorder on same port
drvAsynIPPortConfigure("L101", "192.168.168.10:50000",0,0,0)

# PI_E712_CreateController("Port name","asyn Port name","Number of axes","moving polling time [msec]","idle polling time [msec]") 
#PI_E712_CreateController("E712", "L100", 4, 500, 1000)
#PI_E712_CreateController("E712", "L100", 4, 1, 10)
PI_E712_CreateController("E712", "L100", "L101", 4, 20, 20)


#asynSetTraceIOMask("E712", 0, 9)
#asynSetTraceMask("E712", 0, 9)

PI_E712_MotorConfigAxis("E712", 0, "SampleFineX", 20000, -20000,  500, 0)
PI_E712_MotorConfigAxis("E712", 1, "SampleFineY", 20000, -20000,  500, 0)
PI_E712_MotorConfigAxis("E712", 2, "ZoneplateX", 20000, -20000,  500, 0)
PI_E712_MotorConfigAxis("E712", 3, "ZoneplateY", 20000, -20000,  500, 0)

# PI_E712_MotorConfigAxis("Port name", "Axis #", "Axis name",  "High limit", "Low limit", "Home position", "Start posn", "Simulate")
#PI_E712_MotorConfigAxis("E712", 0, "SampleFineX", 20000, -20000,  500, 0, 1)
#PI_E712_MotorConfigAxis("E712", 1, "SampleFineY", 20000, -20000,  500, 0, 1)
#PI_E712_MotorConfigAxis("E712", 2, "ZoneplateX", 20000, -20000,  500, 0, 0)
#PI_E712_MotorConfigAxis("E712", 3, "ZoneplateY", 20000, -20000,  500, 0, 0)



dbLoadRecords(("$(TOP)/db/e712.db", "P=IOC:,M=m100:,PORT=E712,ADDR=0,TIMEOUT=1")
dbLoadRecords(("$(TOP)/db/e712.db", "P=IOC:,M=m101:,PORT=E712,ADDR=1,TIMEOUT=1")
dbLoadRecords(("$(TOP)/db/e712.db", "P=IOC:,M=m102:,PORT=E712,ADDR=2,TIMEOUT=1")
dbLoadRecords(("$(TOP)/db/e712.db", "P=IOC:,M=m103:,PORT=E712,ADDR=3,TIMEOUT=1")

dbLoadRecords(("$(TOP)/db/e712_controller.db", "P=IOCE712:,PORT=E712,ADDR=0,TIMEOUT=1")


dbLoadRecords("$(ASYN)/db/asynRecord.db", "P=IOC:, R=L100, PORT=L100, ADDR=0, OMAX=256, IMAX=256") 



#########################################################
#XPS
dbLoadTemplate "$(TOP)/iocBoot/iocXPSWithAsyn/motor.substitutions.xps_uhv"
#XPSCreateController("XPS2", "192.168.168.100", 5001, 5, 10, 10, 1, 500)
XPSCreateController("XPS2", "192.168.168.100", 5001, 5, 2, 10, 1, 500)

#asynSetTraceIOMask("XPS2", 0, 255)
#asynSetTraceMask("XPS2", 0, 255)

# stepSize = 1 / stages.ini[DisplacementPerFullStep]
# XPS asyn port,  axis, groupName.positionerName, stepSize

XPSCreateAxis("XPS2",0,  "CoarseX.X",  	"1000")
XPSCreateAxis("XPS2",1,  "CoarseY.Y",  	"1000")	
XPSCreateAxis("XPS2",2,  "DetectorX.X", "1000")
XPSCreateAxis("XPS2",3,  "DetectorY.Y", "1000")
XPSCreateAxis("XPS2",4,  "DetectorZ.Z", "1000")

#prevent the controller from reporting a "controller error" id the axis is disabled
XPSNoDisableError("XPS2")
XPSEnableMovingMode("XPS2")
dbLoadRecords("$(ASYN)/db/asynRecord.db", "P=IOC:, R=XPS2, PORT=XPS2, ADDR=0, OMAX=256, IMAX=256")   

#########################################################
# AbsMotor_CreateController("Fine Stage Port name", "Fine Axis Number", "Coarse Stage Port name", "Coarse Axis Number", "Coarse Step Size", "Moving poll rate (ms)", "Idle poll rate (ms)")
AbsMotor_CreateController("UhvAbs2Mtr", "E712", "XPS2", 2, 10)
#AbsMotor_CreateAxis("Abstract Controller Portname", Axis Num, Axis Name, Fine Axis Num, Coarse Axis Num, Coarse StepSize, Fine scan range)

#AbsMotor_CreateAxis("Abstract Controller Portname", Axis Num, Axis Name, Fine Axis Num, Coarse Axis Num, Coarse StepSize, Coarse Direction, Fine scan range, max velo)
#Coarse Direction: is a sign that is applied to the coarse setpoint
#AbsMotor_CreateAxis("UhvAbs2Mtr", 0, "SampleX",  0, 0, 1000, 1, 100, 3500)
#AbsMotor_CreateAxis("UhvAbs2Mtr", 1, "SampleY",  1, 1, 983.816, 1, 30, 1500) # 983.816 = 1 / 0.00101645


#AbsMotor_CreateAxis("UhvAbs2Mtr", 0, "SampleX",  0, 0, 1000, 1, $(MAX_FINEX_SCAN_RANGE), 3500)
#AbsMotor_CreateAxis("UhvAbs2Mtr", 1, "SampleY",  1, 1, 983.816, 1, $(MAX_FINEY_SCAN_RANGE), 1500) # 983.816 = 1 / 0.00101645
# NO INTERFEROMETER
#AbsMotor_CreateAxis("UhvAbs2Mtr", 0, "SampleX",  0, 0, 1000, 1, $(MAX_FINEX_SCAN_RANGE), 3500, 0)
#AbsMotor_CreateAxis("UhvAbs2Mtr", 1, "SampleY",  1, 1, 983.816, 1, $(MAX_FINEY_SCAN_RANGE), 1500, 0) 

#using Zoneplate XY
AbsMotor_CreateAxis("UhvAbs2Mtr", 0, "ZoneplateX",  2, 0, 1000, 1, $(MAX_FINEX_SCAN_RANGE), 3500, 1)
AbsMotor_CreateAxis("UhvAbs2Mtr", 1, "ZoneplateY",  3, 1, 1000, 1, $(MAX_FINEY_SCAN_RANGE), 1500, 1) 

dbLoadTemplate "$(IOCDIR)/motor.substitutions.abs"

dbLoadRecords("db/e712_scan_support.db", "P=IOCE712")   


#asynSetTraceIOMask("E712", 0, 4)
#asynSetTraceMask("E712", 0, 255)
#asynSetTraceMask("XPS2", 4, 0x10)
#asynSetTraceMask("UhvAbs2Mtr", 0, 0x10)

epicsEnvSet(AUTOSAVE_PREFIX,"uhv-absmotor")
epicsEnvSet(BL,"uhv")

< $(TOP)/autosave-1.cmd

iocInit

# save positions every five seconds, it will look only in the dir setup in set_requestfile_path()
create_monitor_set("uhv-absmotor.req", 5, "P=IOC")

dbpf(IOC:m117:FineMaxVelo, "4000")
dbpf(IOC:m118:FineMaxVelo, "4000")

dbpf(IOC:m117:CoarseMaxVelo, "3500")
dbpf(IOC:m118:CoarseMaxVelo, "3500")

dbpf(IOC:m100:ServoPower, "0")
dbpf(IOC:m101:ServoPower, "0")
dbpf(IOC:m102:ServoPower, "0")
dbpf(IOC:m103:ServoPower, "0")


dbpf(IOC:m112:XPS_POWER, "0")
dbpf(IOC:m113:XPS_POWER, "0")
dbpf(IOC:m114:XPS_POWER, "0")
dbpf(IOC:m115:XPS_POWER, "0")
dbpf(IOC:m116:XPS_POWER, "0")


#set motors to turn off after a move
dbpf(IOC:m112:XPS_AUTO_DISABLE_MODE, "1")
dbpf(IOC:m113:XPS_AUTO_DISABLE_MODE, "1")
dbpf(IOC:m114:XPS_AUTO_DISABLE_MODE, "1")
dbpf(IOC:m115:XPS_AUTO_DISABLE_MODE, "1")
dbpf(IOC:m116:XPS_AUTO_DISABLE_MODE, "1")

#set 0 for enabled, 1 for disabled
epicsEnvSet(START_EN_DISABLED, 0)

dbpf(IOC:m100_able.VAL, "$(START_EN_DISABLED)")
dbpf(IOC:m101_able.VAL, "$(START_EN_DISABLED)")
dbpf(IOC:m102_able.VAL, "$(START_EN_DISABLED)")
dbpf(IOC:m103_able.VAL, "$(START_EN_DISABLED)")
dbpf(IOC:m104_able.VAL, "$(START_EN_DISABLED)")
dbpf(IOC:m105_able.VAL, "$(START_EN_DISABLED)")
dbpf(IOC:m106_able.VAL, "$(START_EN_DISABLED)")
dbpf(IOC:m107_able.VAL, "$(START_EN_DISABLED)")
dbpf(IOC:m108_able.VAL, "$(START_EN_DISABLED)")
dbpf(IOC:m109_able.VAL, "$(START_EN_DISABLED)")
dbpf(IOC:m110_able.VAL, "$(START_EN_DISABLED)")
dbpf(IOC:m111_able.VAL, "$(START_EN_DISABLED)")
dbpf(IOC:m112_able.VAL, "$(START_EN_DISABLED)")
dbpf(IOC:m113_able.VAL, "$(START_EN_DISABLED)")
dbpf(IOC:m114_able.VAL, "$(START_EN_DISABLED)")
dbpf(IOC:m115_able.VAL, "$(START_EN_DISABLED)")
dbpf(IOC:m116_able.VAL, "$(START_EN_DISABLED)")
dbpf(IOC:m117_able.VAL, "$(START_EN_DISABLED)")
dbpf(IOC:m118_able.VAL, "$(START_EN_DISABLED)")


# while simulating fx and fx
dbpf(IOC:m100:calibDone.DISA, "1")
dbpf(IOC:m101:calibDone.DISA, "1")

dbpf(IOC:m100:calibDone, "1")
dbpf(IOC:m101:calibDone, "1")

####st.amd.ZONEPLATE_SCANNING

# the directory is currently [C:\controls\epics\R3.14.12.4\modules\support\motor-6-8\paramFiles]
dbpf("IOCE712:ParamFileName", "zoneplate_mode.pam")
epicsThreadSleep(5.0)

dbpf("IOCE712:LoadParamFile", "1")


