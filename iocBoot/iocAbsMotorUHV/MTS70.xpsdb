;--- OSA: X,Y
;--- DETECTOR X,Y
 
;--- unit =micrometers

;--- Stage
SmartStageName=

;--- Driver
DriverName=XPS-DRV01
DriverPWMFrequency=50; kHz
DriverStepperWinding=Full; Full or Half

;--- Motor driver interface
MotorDriverInterface=AnalogStepperPosition
MicroStepFactor=50
DisplacementPerFullStep=5; units
ScalingCurrent=3; amps for 10 V
PeakCurrentPerPhase=1.0; amps
StandbyPeakCurrentPerPhase=0.2; amps
BaseVelocity=200; units / sec

;--- Encoder
EncoderType=AquadB
EncoderResolution=0.1; unit
LinearEncoderCorrection=0; ppm

;----Gathering
CurrentVelocityCutOffFrequency=10
CurrentAccelerationCutOffFrequency=100

;--- Backlash
Backlash=0; unit

;--- Positioner mapping
PositionerMappingFileName=

;--- Travels
MinimumTargetPosition=-4700; unit
HomePreset=0; unit
MaximumTargetPosition=5000; unit

;--- Home
HomeSearchSequenceType=MinusEndOfRunAndIndexHomeSearch

;HomeSearchSequenceType = CurrentPositionAsHome
HomeSearchMaximumVelocity=500; unit / second
HomeSearchMaximumAcceleration=8000; unit / second
HomeSearchTimeOut=152; second

;--- Profiler
MaximumVelocity=8000; unit / second
MaximumAcceleration=10000; unit / second2
EmergencyDecelerationMultiplier=1
MinimumJerkTime=0.005; second
MaximumJerkTime=0.05; second
TrackingCutOffFrequency=25; Hz

;--- Motion done
MotionDoneMode=Theoretical

;--- Corrector
CorrectorType=PIPosition

KD=0

KP=0
KI=20
KS=1
IntegrationTime=1
ClosedLoopStatus=Closed; Opened or Closed
;FatalFollowingError=12
FatalFollowingError=15

DeadBandThreshold=0; units

;--- Notch Filter
NotchFrequency1=0; Hertz
NotchBandwidth1=0; Hertz
NotchGain1=1
NotchFrequency2=0; Hertz
NotchBandwidth2=0; Hertz
NotchGain2=1

;--- Servitude
ServitudesType=StandardEORDriverPlug
