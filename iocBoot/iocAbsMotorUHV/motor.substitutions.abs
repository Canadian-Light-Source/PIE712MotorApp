file "$(TOP)/db/cls_asyn_motor.db"
{
	pattern
	{P,     N,  M,        DTYP,         	PORT,       	ADDR,  DESC,      EGU, DIR,  VELO,  VBAS,  ACCL,  BDST,  BVEL,  BACC, MRES,  PREC,  DHLM,  	DLLM,  		INIT	RTRY, RDBD, UEIP, FOFF, VMAX, 	ERES}     
	{IOC:,  117,  "m$(N)",  "asynMotor",  "UhvAbs2Mtr", 0,    "SampleX",  um,  Pos,  3500, 0.0,   0.01,  0.0,   1,     .2,   0.001, 3,     7000, 		-3500,  ""		0, 		0, 		1, 		0, 		3500,		0.001}    
	{IOC:,  118,  "m$(N)",  "asynMotor",  "UhvAbs2Mtr", 1,    "SampleY",  um,  Pos,  1500, 0.0,   0.01,  0.0,   1,     .2,   0.001, 3,     7000,  	-2000,  ""		0, 		0, 		1, 		0, 		1500,		0.001}   
}

#the values of coarse and fine motors comes from the main cmd file
file "$(TOP)/db/AbsMotor.db"
{
	pattern
	{P,     M,      PORT,     ADDR,  	TIMEOUT	}
	{IOC:,	m117:,	"UhvAbs2Mtr",	0,			1 			}
	{IOC:,	m118:,	"UhvAbs2Mtr",	1,			1 			}
}

file "$(TOP)/db/motorCal.db"
{
	pattern
	{clsdev,  motor, 	unit,   calibPosn,   	move1, 	move2, calibLimit,  finalPosn,	offset}
	{IOC:, 		m117, 		um,				0.0					0,			0,			HLS, 				0,			0		}      # SampleX  
	{IOC:, 		m118, 		um,				0.0					0,			0,			HLS, 				0,			0		}      # SampleY  
	
}
