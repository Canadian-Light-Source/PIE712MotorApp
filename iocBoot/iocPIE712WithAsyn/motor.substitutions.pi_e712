file "$(TOP)/db/motorCal.db"
{
	pattern
	{clsdev,  motor, 	unit,   calibPosn,   	move1, 	move2, calibLimit,  finalPosn,	offset}
	{IOC:, 		m100, 		um,				0.0					0,			0,			HLS, 				0,			0		}      # SampleFineX  
	{IOC:, 		m101, 		um,				0.0					0,			0,			HLS, 				0,			0		}      # SampleFineY  
	{IOC:, 		m102, 		um,				0.0					0,			0,			HLS, 				0,			0		}      # ZoneplateX   
	{IOC:, 		m103, 		um,				8000.0			0,			0,			HLS, 				0,			0		}      # ZoneplateY   
	
}



