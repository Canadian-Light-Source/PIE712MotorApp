# VERY Important for XPS controller, set VBAS to 0.0, set ACCL to (max velo stated in XPS stages.ini) / (max accel stated in XPS stages.ini)
file "$(TOP)/db/asyn_motor.db"
{
	pattern
	{P,    N, 	M,       DTYP,   		PORT, 	ADDR, DESC,   				EGU,	DIR,   VELO,  	VBAS, 	ACCL, 	BDST, BVEL, BACC, 	MRES, PREC,  	DLLM, 	DHLM, 	RTRY	INIT}
	{IOC:, 100, "m$(N)", "asynMotor",	"E712", 	0, 		"SampleFineX",	um,  	Pos,    1000.0, 0.00,  	1.0,    0,  	.2,   .2,    	0.001,  5,   		-100,		100,  0,			""}
	{IOC:, 101, "m$(N)", "asynMotor",	"E712", 	1, 		"SampleFineY",	um,  	Pos,    1000.0, 0.00,  	1.0,    0,  	.2,   .2,    	0.001,  5,   		-100,		100,  0,			""}
	{IOC:, 102, "m$(N)", "asynMotor",	"E712", 	2, 		"ZoneplateX",		um,  	Pos,    1000.0, 0.00,  	1.0,    0,  	.2,   .2,    	0.001,  5,   		-100,		100,  0,			""}
	{IOC:, 103, "m$(N)", "asynMotor",	"E712", 	3, 		"ZoneplateY",		um,  	Pos,    1000.0, 0.00,  	1.0,    0,  	.2,   .2,    	0.001,  5,   		-100,		100,  0,			""}
}

