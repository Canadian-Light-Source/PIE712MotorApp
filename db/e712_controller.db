
###################################################################
#  Records that use devAsynOctet                                  #
###################################################################
record(stringout, "$(P)GetIDN")
{
   field(PINI, "NO")
   field(DTYP, "asynOctetWrite")
   field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))PI_GET_IDN")
   field(VAL,  "*IDN?")
   field(TPRO, "1")
}

record(stringin, "$(P)GetIDN_RBV")
{
	 field(PINI, "NO")
   field(DTYP, "asynOctetRead")
   field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))PI_GET_IDN")
   field(SCAN, "I/O Intr")
   field(TPRO, "1")
}



