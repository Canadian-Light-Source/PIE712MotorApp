#	createParam(P_ServoOffAndCntrString,          asynParamInt32,       &P_ServoOffAndCntr);
#	setIntegerParam (P_ServoOffAndCntr,       0);
#
#################################################################

#################################################################
#  a binary write and readback param                              								#
#################################################################
record(bo, "$(P)$(M)ServoOffAndCntr")
{
    field(PINI,  "NO")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))PI_SERVO_OFF_AND_CENTER")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
    field(HIGH, "0.2")
}

record(bi, "$(P)$(M)ServoOffAndCntr_RBV")
{
    field(PINI, "NO")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))PI_SERVO_OFF_AND_CENTER")
    field(ZNAM, "OFF")
    field(ZSV,  "NO_ALARM")
    field(ONAM, "ONing")
    field(OSV,  "MINOR")
    field(SCAN, "I/O Intr")
}