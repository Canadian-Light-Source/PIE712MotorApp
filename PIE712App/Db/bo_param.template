#################################################################
#  a binary write and readback param                              								#
#################################################################
record(bo, "$(P)$(M)$(param)")
{
    field(PINI,  "$(pini)")
    field(DTYP, "$(param_type)")
    field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))$(port_drvr_string)")
    field(ZNAM, "$(znam)")
    field(ONAM, "$(onam)")
    field(HIGH, "$(high)")
}

