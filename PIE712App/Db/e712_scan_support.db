
record(busy, "$(P):run_scan_config")
{
	field(ZNAM, "Done")
	field(ONAM, "Running")
}


record(ai, "$(P):image_idx")
{
	field(VAL, "0")
}

record(bo, "$(P):abort_scan_config")
{
		field(HIGH, "0.5")

}

###############################################
record(waveform, "$(P):dwells")
{
		 field(DTYP, "Soft Channel")
   field(NELM, "120")
   field(FTVL, "DOUBLE")
   field(TPRO, "1")
}


###############################################
record(waveform, "$(P):xreset:posns")
{
	field(DTYP, "Soft Channel")
   field(NELM, "120")
   field(FTVL, "DOUBLE")
   field(TPRO, "1")
   
}
record(waveform, "$(P):yreset:posns")
{
	field(DTYP, "Soft Channel")
   field(NELM, "120")
   field(FTVL, "DOUBLE")
   field(TPRO, "1")
   
}

###############################################

record(waveform, "$(P):sp_roi:ids")
{
	field(NELM, "10")
  field(FTVL, "SHORT")
  field(TPRO, "1")
}

record(ao, "$(P):sp_roi:current")
{
	field(DESC, "the current executing spid")	
	field(VAL, "0")
}

