###############################################
# 30000 is the maximum number of points available on the E712
# for waveforms, it is a total pool of points so it must be shared 
# among all 
# (up to 10 supported)
record(waveform, "$(P):ddl:0")
{
		 field(DTYP, "Soft Channel")
   field(NELM, "30000")
   field(FTVL, "FLOAT")
   field(TPRO, "1")
}

