#################################################################
record(mbbo, "$(P)DataRecT1Option")
{
   field(PINI, "1")
   field(DTYP, "asynInt32")
   field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))PI_DR_T1_OPTION")
   field(ZRST, "Target Position of axis")
   field(ZRVL, "1")
   field(ONST, "Current Position of axis")
   field(ONVL, "2")
   field(TWST, "Position Error of axis")
   field(TWVL, "3")
   field(THST, "Cntrl Voltage output ch")
   field(THVL, "7")
   field(FRST, "DDL Output of axis")
   field(FRVL, "13")
   field(FVST, "Open Loop Control of axis")
   field(FVVL, "14")
   field(SXST, "Control Output of axis")
   field(SXVL, "15")
   field(SVST, "Voltage of output chan")
   field(SVVL, "16")
   field(EIST, "ELinear of input chan")
   field(EIVL, "19")
   field(NIST, "MLinear of input chan")
   field(NIVL, "20")
   field(TEST, "Slowed Trgt pos of axis")
   field(TEVL, "22")
   field(ELST, "Target velocity of axis")
   field(ELVL, "23")
   field(TVST, "Target accel of axis")
   field(TVVL, "24")
   field(TTST, "Target jerk of axis")
   field(TTVL, "25")
   field(FTST, "Value of Digital Input")
   field(FTVL, "26")
   field(FFST, "Value of Digital Output")
   field(FFVL, "27")  
   
}

record(ai, "$(P)DataRecT1Option_RBV")
{
   field(PINI, "1")
   field(DTYP, "asynInt32")
   field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))PI_DR_T1_OPTION")
   field(SCAN, "I/O Intr")
}###################################################################
